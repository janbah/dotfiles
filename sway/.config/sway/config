# Sway config (konvertiert von i3)
set $mod Mod4
font pango:JetBrains Mono 10

bindsym $mod+plus gaps inner all plus 1
bindsym $mod+minus gaps inner all minus 1

focus_follows_mouse no
### Eingabegeräte ###
input type:keyboard {
    xkb_layout de
    xkb_variant nodeadkeys
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

### Ausgabe / Wallpaper (ersetzt feh) ###
output * bg ~/Pictures/ocean_with_cloud.png fill

### Autostart ###
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec gammastep -l 51.4:6.8
exec mako
exec flatpak run com.nextcloud.desktopclient.nextcloud --background
exec /usr/lib/mate-polkit/polkit-mate-authentication-agent-1
# Sperren bei Inaktivität (10 min) und vor Suspend (ersetzt xss-lock)
exec swayidle -w \
    timeout 600 'swaylock -f -i ~/Pictures/ocean_with_cloud.png' \
    before-sleep 'swaylock -f -i ~/Pictures/ocean_with_cloud.png'

### Lautstärke mit Notification ###
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5% && notify-send -t 300 "Volume: $(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+%' | head -1)"
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5% && notify-send -t 300 "Volume: $(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+%' | head -1)"
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && notify-send -t 300 "Mute: $(pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}')"

### Helligkeit mit Notification ###
bindsym XF86MonBrightnessUp exec brightnessctl set +10% && notify-send -t 300 "Brightness: $(brightnessctl -m | cut -d, -f4)"
bindsym XF86MonBrightnessDown exec brightnessctl set 10%- && notify-send -t 300 "Brightness: $(brightnessctl -m | cut -d, -f4)"

### Fenster-Handling ###
floating_modifier $mod
bindsym $mod+Return exec kitty
bindsym $mod+q kill
bindsym $mod+d exec fuzzel
for_window [app_id="floating_shell"] floating enable

# Fokus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Fenster verschieben
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layout
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

### Workspaces ###
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

### Sperren & Suspend ###
bindsym $mod+z exec swaylock -f -i ~/Pictures/ocean_with_cloud.png
bindsym $mod+Shift+z exec systemctl suspend

### Screenshot: Bereich auswählen -> Zwischenablage (ersetzt maim/xclip) ###
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy

### Sway-Verwaltung ###
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Sway wirklich beenden?' -B 'Ja, beenden' 'swaymsg exit'

### Optik ###
default_border pixel 2
default_floating_border pixel 2
for_window [app_id=".*"] border pixel 2
for_window [class=".*"] border pixel 2
titlebar_padding 1
gaps inner 3
gaps outer 1

# Dialoge schweben lassen (Dateiwähler, Popups, Einstellungsfenster)
for_window [app_id="xdg-desktop-portal-gtk"] floating enable, resize set 1000 700, move position center
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable

# Ozean-Rahmenfarben:      border   background text     indicator childborder
client.focused             #7fb4d9  #7fb4d9    #0b1d2e  #56b6c2   #7fb4d9
client.focused_inactive    #1b3a57  #1b3a57    #e8f1f8  #1b3a57   #1b3a57
client.unfocused           #0b1d2e  #0b1d2e    #7fb4d9  #0b1d2e   #0b1d2e
client.urgent              #e06c75  #e06c75    #e8f1f8  #e06c75   #e06c75

### Resize-Modus ###
mode "resize" {
    bindsym j resize shrink width 10px
    bindsym k resize grow height 10px
    bindsym l resize shrink height 10px
    bindsym odiaeresis resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

### Bar (ersetzt i3bar/i3status) ###
bar {
    swaybar_command waybar
}
